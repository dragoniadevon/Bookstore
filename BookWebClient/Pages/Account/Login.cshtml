@page
@* Страница входа (адрес "/Account/Login"). *@
@model BookWebClient.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Вхід";
}

<div class="auth-card">
    <div class="shop-panel p-4 p-md-5">
        <h1 class="h3 mb-1">Вхід</h1>
        <p class="text-muted-shop mb-4">Увійдіть, щоб оформити замовлення і бачити історію покупок.</p>

        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>
            <div class="form-check mb-4">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">Увійти</button>
        </form>

        <p class="text-center mt-4 mb-0">
            Немає акаунта? <a asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">Зареєструйтеся</a>
        </p>
    </div>

    @* Подсказка для демонстрации — встроенные пользователи из InMemoryUserStore *@
    <div class="alert alert-light border small mt-3 test-cards">
        <strong>Демо-акаунти:</strong><br />
        Покупець — <code>demo@bookstore.local</code> / <code>demo123</code><br />
        Адміністратор — <code>admin@bookstore.local</code> / <code>admin123</code>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
