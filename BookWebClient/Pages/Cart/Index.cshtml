@page
@* Корзина покупателя (адрес "/Cart"). *@
@model BookWebClient.Pages.Cart.IndexModel
@{
    ViewData["Title"] = "Кошик";
}

<h1 class="mb-4">Кошик</h1>

@if (Model.Items.Count == 0)
{
    <div class="shop-panel empty-state">
        <div class="empty-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" />
                <path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6" />
            </svg>
        </div>
        <h2 class="h5">У кошику поки порожньо</h2>
        <p class="text-muted-shop">Загляньте до каталогу — там багато гарних книг.</p>
        <a class="btn btn-primary" asp-page="/Index">Перейти до каталогу</a>
    </div>
}
else
{
    <div class="row g-4">
        @* ---------- Список позиций ---------- *@
        <div class="col-lg-8">
            <div class="shop-panel">
                @foreach (var item in Model.Items)
                {
                    <div class="d-flex gap-3 p-3 border-bottom align-items-center flex-wrap flex-sm-nowrap">
                        <a asp-page="/Books/Details" asp-route-id="@item.BookId">
                            <partial name="_BookCover" model="@(new BookCoverModel(item.BookId, item.Title, item.AuthorName, item.ImageUrl, "cover-sm"))" />
                        </a>

                        <div class="flex-grow-1">
                            <a class="fw-semibold text-decoration-none text-reset" asp-page="/Books/Details" asp-route-id="@item.BookId">@item.Title</a>
                            <div class="small text-muted-shop">@item.AuthorName</div>
                            <div class="small text-muted-shop">@item.Price.ToUah() за шт.</div>
                        </div>

                        @* Изменение количества: каждая кнопка — отдельная маленькая форма *@
                        <div class="d-flex align-items-center gap-1">
                            <form method="post" asp-page-handler="Update">
                                <input type="hidden" name="bookId" value="@item.BookId" />
                                <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm" aria-label="Зменшити">−</button>
                            </form>
                            <span class="px-2 fw-semibold" style="min-width: 2rem; text-align: center">@item.Quantity</span>
                            <form method="post" asp-page-handler="Update">
                                <input type="hidden" name="bookId" value="@item.BookId" />
                                <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm" aria-label="Збільшити"
                                        disabled="@(item.MaxQuantity > 0 && item.Quantity >= item.MaxQuantity)">+</button>
                            </form>
                        </div>

                        <div class="text-end" style="min-width: 7rem">
                            <div class="fw-bold">@item.Total.ToUah()</div>
                            <form method="post" asp-page-handler="Remove">
                                <input type="hidden" name="bookId" value="@item.BookId" />
                                <button type="submit" class="btn btn-link btn-sm text-danger p-0">Видалити</button>
                            </form>
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-between p-3">
                    <a class="btn btn-link px-0" asp-page="/Index">← Продовжити покупки</a>
                    <form method="post" asp-page-handler="Clear">
                        <button type="submit" class="btn btn-link text-muted-shop px-0">Очистити кошик</button>
                    </form>
                </div>
            </div>
        </div>

        @* ---------- Итого ---------- *@
        <div class="col-lg-4">
            <div class="shop-panel p-4 position-sticky" style="top: 6rem">
                <h2 class="h5 mb-3">Ваше замовлення</h2>
                <div class="summary-row">
                    <span class="text-muted-shop">@Model.Count.Plural("книга", "книги", "книг")</span>
                    <span>@Model.Total.ToUah()</span>
                </div>
                <div class="summary-row">
                    <span class="text-muted-shop">Доставка</span>
                    <span class="text-success">Безкоштовно</span>
                </div>
                <div class="summary-row summary-total">
                    <span>Разом</span>
                    <span>@Model.Total.ToUah()</span>
                </div>

                <a class="btn btn-primary btn-lg w-100 mt-3" asp-page="/Checkout/Index">Оформити замовлення</a>

                @if (User.Identity?.IsAuthenticated != true)
                {
                    <p class="small text-muted-shop mt-3 mb-0 text-center">
                        Для оформлення потрібно <a asp-page="/Account/Login" asp-route-returnUrl="/Checkout">увійти</a>
                        або <a asp-page="/Account/Register" asp-route-returnUrl="/Checkout">зареєструватися</a>.
                    </p>
                }
            </div>
        </div>
    </div>
}
