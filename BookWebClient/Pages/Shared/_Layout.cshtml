@* _Layout.cshtml — общий шаблон для всех страниц сайта.
   Здесь то, что одинаково везде: подключение стилей и скриптов, шапка с меню,
   сообщения об успехе/ошибке и подвал.
   Содержимое конкретной страницы вставляется на место @RenderBody().

   Папка Shared — для общих частей, которые используются многими страницами. *@
@using Bookstore.WebClient.Service.Interface

@* @inject — получить сервис из Dependency Injection прямо в разметке.
   Корзина нужна для счётчика в шапке, переключатель — для кнопок "Мок / API". *@
@inject ICartService Cart
@inject IDataSourceSwitch DataSource
@{
    var cartCount = await Cart.CountAsync();
    var isAdmin = User.IsInRole(ShopRoles.Admin);

    // Текущий адрес вместе с параметрами — чтобы после переключения
    // источника данных вернуться на ту же страницу.
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="uk" data-bs-theme="light">
<head>
    <meta charset="utf-8" />

    @* Правильное масштабирование на телефонах. *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @* Заголовок вкладки: берётся из ViewData["Title"], который задаёт каждая страница. *@
    <title>@ViewData["Title"] — Книжкова крамниця</title>
    <script type="importmap"></script>

    @* Шрифты Google Fonts: Lora — для заголовков, Inter — для текста.
       Если интернета нет, браузер возьмёт запасные шрифты из site.css. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@600;700&display=swap" />

    @* Подключаем CSS. "~/" — корень сайта, то есть папка wwwroot.
       Bootstrap — готовая библиотека стилей: сетка, кнопки, меню и т.д. *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    @* Наши собственные стили (тема магазина).
       asp-append-version добавляет к адресу "?v=хеш файла". Когда файл меняется,
       меняется и адрес, поэтому браузер не возьмёт старую версию из кеша. *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* Стили из файлов вида _Layout.cshtml.css (CSS, который действует только на одну страницу).
       ASP.NET Core собирает их в файл <ИмяСборки>.styles.css. *@
    <link rel="stylesheet" href="~/Bookstore.WebClient.styles.css" asp-append-version="true" />
</head>
<body>
    @* ---------- Шапка ---------- *@
    <header class="shop-header sticky-top">
        <nav class="navbar navbar-expand-lg py-2">
            <div class="container">
                <a class="shop-brand text-decoration-none" asp-page="/Index">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M2 4h6a4 4 0 0 1 4 4v12a3 3 0 0 0-3-3H2z" />
                        <path d="M22 4h-6a4 4 0 0 0-4 4v12a3 3 0 0 1 3-3h7z" />
                    </svg>
                    Книжкова крамниця
                </a>

                @* Кнопка "гамбургер" — появляется на узких экранах и раскрывает меню. *@
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Відкрити меню">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">Каталог</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Account/Orders">Мої замовлення</a>
                            </li>
                        }
                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Admin/Books/Index">Керування книгами</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-3 py-2 py-lg-0">
                        @* Переключатель источника данных: мок-данные в памяти или Bookstore.Api.
                           Это форма с двумя кнопками: нажатая кнопка отправляет своё значение mode. *@
                        <form method="post" asp-page="/DataSource" class="source-switch d-flex align-items-center gap-2"
                              title="Звідки магазин бере книги">
                            <input type="hidden" name="returnUrl" value="@currentUrl" />
                            <span class="small text-muted-shop">Дані:</span>
                            <div class="btn-group" role="group" aria-label="Джерело даних">
                                <button type="submit" name="mode" value="@DataSourceMode.Mock"
                                        class="btn btn-outline-secondary @(DataSource.Mode == DataSourceMode.Mock ? "active-source" : "")">Мок</button>
                                <button type="submit" name="mode" value="@DataSourceMode.Api"
                                        class="btn btn-outline-secondary @(DataSource.Mode == DataSourceMode.Api ? "active-source" : "")">API</button>
                            </div>
                        </form>

                        @* Корзина со счётчиком *@
                        <a class="nav-link cart-link d-inline-flex align-items-center gap-2" asp-page="/Cart/Index" aria-label="Кошик">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" />
                                <path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6" />
                            </svg>
                            <span class="d-lg-none">Кошик</span>
                            @if (cartCount > 0)
                            {
                                <span class="cart-badge">@cartCount</span>
                            }
                        </a>

                        @* Пользователь: имя и выход, либо ссылки на вход и регистрацию *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <button class="btn btn-light border dropdown-toggle d-inline-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" />
                                    </svg>
                                    @User.Identity.Name
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-page="/Account/Orders">Мої замовлення</a></li>
                                    @if (isAdmin)
                                    {
                                        <li><a class="dropdown-item" asp-page="/Admin/Books/Index">Керування книгами</a></li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        @* Выход — только POST-запросом (с защитой от подделки),
                                           чтобы пользователя нельзя было "разлогинить" обычной ссылкой. *@
                                        <form method="post" asp-page="/Account/Logout">
                                            <button type="submit" class="dropdown-item">Вийти</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex gap-2">
                                <a class="btn btn-outline-primary" asp-page="/Account/Login">Увійти</a>
                                <a class="btn btn-primary" asp-page="/Account/Register">Реєстрація</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @* ---------- Основная часть ---------- *@
    <main role="main" class="container py-4">
        @* Сообщения "Книга добавлена в корзину" и т.п.
           TempData хранит значение ровно до следующего запроса — удобно
           для сообщений после перенаправления (паттерн Post/Redirect/Get). *@
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @success
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрити"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрити"></button>
            </div>
        }

        @RenderBody()
    </main>

    @* ---------- Подвал ---------- *@
    <footer class="shop-footer py-4 mt-4">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
            <div>&copy; 2026 Книжкова крамниця — навчальний проєкт Bookstore</div>
            <div>
                Джерело даних: <strong>@(DataSource.Mode == DataSourceMode.Mock ? "мок-дані" : "Bookstore.Api")</strong>
                · <a asp-page="/Privacy">Конфіденційність</a>
            </div>
        </div>
    </footer>

    @* Скрипты подключаем в конце body, чтобы страница сначала отрисовалась,
       а потом загружался JavaScript — так сайт кажется быстрее.
       jQuery — нужна для валидации форм; bootstrap.bundle — меню, выпадающие списки. *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* Место, куда страница может добавить свои скрипты через @section Scripts { ... }. *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
