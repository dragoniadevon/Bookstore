@page
@* Error.cshtml — страница, которую видит пользователь, если на сервере произошла ошибка.
   Показывается только НЕ в режиме разработки (см. app.UseExceptionHandler в Program.cs).
   В режиме разработки вместо неё ASP.NET Core показывает подробности ошибки. *@
@model ErrorModel
@{
    ViewData["Title"] = "Помилка";
}

<div class="shop-panel p-4 p-lg-5 mx-auto" style="max-width: 720px">
    <h1 class="text-danger h3">Помилка</h1>
    <p class="mb-3">Під час обробки запиту сталася помилка. Спробуйте ще раз трохи згодом.</p>

    @* Request ID — уникальный номер запроса. Пользователь может сообщить его
       в поддержку, а разработчик по нему найдёт ошибку в логах. *@
    @if (Model.ShowRequestId)
    {
        <p>
            <strong>Ідентифікатор запиту:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a class="btn btn-primary" asp-page="/Index">На головну</a>

    @* Подсказка для разработчика: как увидеть подробности ошибки. *@
    <hr class="my-4" />
    <h2 class="h6 text-muted-shop">Для розробника</h2>
    <p class="small text-muted-shop mb-0">
        Щоб побачити подробиці помилки, запустіть застосунок у середовищі <strong>Development</strong>
        (змінна оточення <strong>ASPNETCORE_ENVIRONMENT</strong> = <strong>Development</strong>).
        На робочому сервері вмикати його не можна: користувачі побачать внутрішні дані застосунку.
    </p>
</div>
