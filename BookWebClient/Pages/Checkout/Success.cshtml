@page "{number}"
@* Страница после успешной оплаты. *@
@model BookWebClient.Pages.Checkout.SuccessModel
@{
    ViewData["Title"] = "Замовлення оформлено";
    var order = Model.Order;
}

<div class="shop-panel p-4 p-lg-5 mx-auto" style="max-width: 720px">
    <div class="text-center mb-4">
        <div class="success-icon mb-3">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
        </div>
        <h1 class="h2">Дякуємо за замовлення!</h1>
        <p class="text-muted-shop mb-0">
            Замовлення <strong class="text-body">@order.Number</strong> сплачено. Ми зв'яжемося з вами за телефоном @order.Phone.
        </p>
    </div>

    <h2 class="h6 text-uppercase text-muted-shop">Склад замовлення</h2>
    <ul class="list-unstyled mb-3">
        @foreach (var item in order.Items)
        {
            <li class="summary-row">
                <span>@item.Title <span class="text-muted-shop">× @item.Quantity</span></span>
                <span>@item.Total.ToUah()</span>
            </li>
        }
    </ul>
    <div class="summary-row summary-total">
        <span>Сплачено</span>
        <span>@order.Total.ToUah()</span>
    </div>

    <dl class="row small mt-4 mb-0">
        <dt class="col-sm-4 text-muted-shop fw-normal">Доставка</dt>
        <dd class="col-sm-8">@order.Address</dd>
        <dt class="col-sm-4 text-muted-shop fw-normal">Картка</dt>
        <dd class="col-sm-8">•••• @order.CardLast4</dd>
        <dt class="col-sm-4 text-muted-shop fw-normal">Транзакція</dt>
        <dd class="col-sm-8"><code>@order.TransactionId</code></dd>
    </dl>

    <div class="d-flex flex-wrap gap-2 justify-content-center mt-4">
        <a class="btn btn-primary" asp-page="/Index">Продовжити покупки</a>
        <a class="btn btn-outline-primary" asp-page="/Account/Orders">Мої замовлення</a>
    </div>
</div>
